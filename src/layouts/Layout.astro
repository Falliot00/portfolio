---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { profile } from '../data/portfolio';
interface Props { title?: string; description?: string }
const { title = `${profile.name} — Desarrollo full stack`, description = 'Portfolio de Fermín Alliot. Desarrollo web, sistemas de gestión e integraciones. De la interfaz a los datos, software pensado para resolver.' } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5ef" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
