---
import Icon from './Icon.astro';
---
<div class="architecture" role="img" aria-label="Ilustración de arquitectura: interfaz, lógica y datos conectados">
  <div class="architecture-top"><span class="mono">UNA IDEA, TODAS SUS CAPAS.</span><span class="architecture-cross">+</span></div>
  <div class="architecture-grid" aria-hidden="true">
    <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
    <div class="arch-card arch-interface"><span class="arch-number">01 / INTERFAZ</span><div class="mini-window"><span></span><span></span><span></span><i></i><b></b><b></b><b></b></div><strong>Lo que ves.</strong><small>React · Next.js</small></div>
    <div class="arch-card arch-logic"><span class="arch-number">02 / LÓGICA</span><div class="code-symbol"><Icon name="code" size={43}/></div><strong>Lo que lo hace funcionar.</strong><small>TypeScript · APIs</small></div>
    <div class="arch-card arch-data"><span class="arch-number">03 / DATOS</span><div class="database"><i></i><i></i><i></i></div><strong>Lo que conecta todo.</strong><small>SQL · Integraciones</small></div>
    <span class="node node-one"></span><span class="node node-two"></span>
  </div>
  <div class="architecture-bottom mono"><span><i></i> DE LA INTERFAZ A LOS DATOS</span><span>F.A / 2026</span></div>
</div>
