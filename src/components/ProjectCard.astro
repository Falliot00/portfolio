---
import Icon from './Icon.astro';
import ProjectVisual from './ProjectVisual.astro';
import type { Project } from '../data/portfolio';
interface Props { project: Project }
const { project } = Astro.props;
---
<article class="project-card" id={project.id}>
  <ProjectVisual kind={project.kind} />
  <div class="project-content">
    <div class="project-meta mono"><span>{project.number} / {project.category}</span><span>{project.period}</span></div>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
    <ul class="tags" aria-label="Tecnologías">{project.stack.map((tool) => <li>{tool}</li>)}</ul>
    <details class="project-details">
      <summary><span>Explorar proyecto<span class="sr-only">: {project.name}</span></span><Icon name="plus" size={18} /></summary>
      <div class="project-detail-body">
        <span class="eyebrow">{project.privacy}</span>
        <h4>El desafío</h4><p>{project.challenge}</p>
        <h4>La solución</h4><p>{project.solution}</p>
        <ul>{project.features.map((feature) => <li>{feature}</li>)}</ul>
        {project.source ? <a class="text-link" href={project.source} target="_blank" rel="noreferrer">Ver código en GitHub <Icon name="arrow" size={16} /><span class="sr-only"> (abre en otra pestaña)</span></a> : <p class="privacy-note">Proyecto privado. Presentación anónima, sin código ni datos de clientes.</p>}
      </div>
    </details>
  </div>
</article>
